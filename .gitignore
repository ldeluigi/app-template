# Gradle / build
.gradle/
.kotlin/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties
*.hprof

# IDEs
.idea/
*.iml
.vscode/
# VS Code's Java extension (Eclipse JDT) compiles into bin/ and may add Eclipse project files
bin/
.project
.classpath
.settings/
.factorypath
captures/
.externalNativeBuild/
.cxx/

# Project-local Android emulator (SDK packages, virtual device, its settings)
.emulator/

# Signing material and API keys must never be committed
*.jks
*.keystore
keystore.properties
play-service-account.json
.env
*.env

# OS
.DS_Store
Thumbs.db

# Release outputs
whatsnew/

# The machinery, checked out by the workflows next to the app
.machinery/

# iOS: the Xcode project is generated by XcodeGen (iosApp/project.yml), its settings by Gradle.
iosApp/*.xcodeproj/
iosApp/build/
iosApp/Configuration/Generated.xcconfig
iosApp/App/Info.plist
xcuserdata/
