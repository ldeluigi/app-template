<?xml version="1.0" encoding="utf-8"?>
<!-- Every text people see. Each language has its own values-xx/strings.xml with the same names: the build checks that
     none is missing, that plurals have every form the language needs, and that arguments match. -->
<resources>
    <string name="count">Count</string>
    <string name="reset">Reset</string>
    <plurals name="counted">
        <item quantity="one">Counted %1$d time</item>
        <item quantity="other">Counted %1$d times</item>
    </plurals>
    <string name="about">About</string>
    <string name="back">Back</string>
    <string name="version">Version %1$s</string>
    <string name="update_available">A new version is ready.</string>
    <string name="update_downloading">Downloading the new version…</string>
    <string name="update_ready">The new version is downloaded.</string>
    <string name="update_later">Later</string>
    <string name="update_now">Update</string>
    <string name="update_restart">Restart to update</string>
</resources>
